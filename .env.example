# Copy this file to .env (gitignored - never commit .env) and fill in
# your own values. Only needed when config/config.yaml's llm.backend is
# a remote provider (openrouter, fireworks) - leave unset for the local
# "ollama" backend.

# Must match config/config.yaml's llm.api_key_env.
OPENROUTER_API_KEY=

# Only needed if llm.backend/llm.api_key_env is set to fireworks -
# get one at https://fireworks.ai/account/api-keys.
FIREWORKS_API_KEY=

# Optional - overrides config/config.yaml's llm.model without editing a
# tracked file, so your personal model pick never needs to be committed.
# Leave blank/omit to use config.yaml's committed default.
GIDEON_LLM_MODEL=nvidia/nemotron-3.5-lightning:free
