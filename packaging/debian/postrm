#!/bin/sh
# Clean up. No system user or group is ever created, so none is removed.
set -e

case "$1" in
    remove)
        # /opt/gideon is emptied by dpkg; drop the dir itself if nothing else
        # put anything there.
        rmdir --ignore-fail-on-non-empty /opt/gideon 2>/dev/null || true
        ;;
    purge)
        # dpkg removes the conffiles themselves; this clears anything the
        # operator added alongside them.
        rm -rf /etc/gideon
        rm -f /etc/default/gideon
        rmdir --ignore-fail-on-non-empty /opt/gideon 2>/dev/null || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
